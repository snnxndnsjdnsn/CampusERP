{
  "name": "sims",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "verify": "node tools/verify.mjs",
    "migrate:build": "python tools/translate.py && python tools/build_migrations.py",
    "test:db": "vitest run tests/db",
    "migrate:apply-check": "node tools/validate/apply.mjs",
    "migrate:apply": "python tools/apply_migrations.py",
    "seed:apply": "python tools/apply_demo_seed.py",
    "admin:create": "node tools/create_admin.mjs",
    "admin:password": "python tools/reset_admin_password.py",
    "docs:schema": "node tools/validate/schema_doc.mjs",
    "docs:roles": "node tools/validate/role_matrix.mjs",
    "migrate:seed-check": "node tools/validate/seed_counts.mjs",
    "migrate:catalogue": "node tools/validate/catalogue.mjs && python tools/compare_catalogue.py",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:concurrency": "vitest run tests/concurrency",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  }
}
