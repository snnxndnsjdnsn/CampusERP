# Supabase (publishable key is client-safe; it is NOT a service-role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=
# The database password of the project. Needed by the tools that open a direct
# connection (tools/dump_catalogue.py, tools/apply_migrations.py,
# tools/validate/catalogue.mjs, tools/create_admin.mjs) and by
# tools/validate/nav_rbac_connectivity.py.  It is never stored in the
# repository - the tools refuse to run when it is missing.
SUPABASE_DB_PASSWORD=
